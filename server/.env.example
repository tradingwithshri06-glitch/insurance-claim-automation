# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Provide your local MongoDB URI or MongoDB Atlas connection string)
MONGODB_URI=mongodb://localhost:27017/insurance_claims_db
# Set to 'true' if you want the server to fall back to an in-memory MongoDB instance when local/remote MongoDB is unreachable
USE_MEMORY_DB_FALLBACK=true

# Security & JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# CORS Configuration
CLIENT_URL=http://localhost:5173

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

